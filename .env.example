APP_NAME="HELIX Compras"
APP_ENV=local
APP_KEY=
# Produção: SEMPRE false (debug expõe stack/env). Dev local: true.
APP_DEBUG=false
APP_URL=http://localhost

# Proxies confiáveis (ALB/nginx): CSV de IPs/CIDRs ou "*". Vazio = nenhum proxy
# confiado (X-Forwarded-* ignorados). Lido em config/trustedproxy.php.
TRUSTED_PROXIES=

# ── Tenancy fail-closed (helix/foundation v0.2.0) ──────────────────────────────
# LIGADO POR PADRÃO e FIXADO em config/foundation.php: consulta/criação em model com
# BelongsToTenant SEM tenant no contexto lança MissingTenantContextException (em vez
# de rodar sem filtro), e gravar noutro tenant lança TenantMismatchException.
# Comandos/jobs/subscribers estabelecem o tenant com TenantContext::runFor/eachTenant.
# Estas variáveis só servem para AFROUXAR deliberadamente numa janela de migração —
# não as deixe em `false` em produção (o helix:doctor e o kit de conformidade reprovam).
# HELIX_TENANCY_STRICT=true
# HELIX_TENANCY_ENFORCE_STAMP=true

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=
# MySQL gerenciado (RDS) exige TLS: caminho do bundle da CA (ex.: global-bundle.pem).
MYSQL_ATTR_SSL_CA=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Cookie/prefixos EXPLÍCITOS por app: apps da suíte no mesmo domínio/Redis não
# podem colidir sessão, cache ou chaves Redis.
SESSION_COOKIE=helix_compras_session
# Produção: cookie só via HTTPS. Dev local sem HTTPS (http://*.test): false.
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
# Dev: local. Produção: s3 (preencha AWS_* abaixo e AWS_BUCKET).
FILESYSTEM_DISK=local
# FILESYSTEM_DISK=s3
QUEUE_CONNECTION=database

# Scheduler onOneServer()/withoutOverlapping() usam o lock do cache default:
# em produção multi-nó o store tem de ser COMPARTILHADO (redis ou database) —
# com file/array cada nó tem o próprio lock e as tarefas rodam N vezes.
CACHE_STORE=database
CACHE_PREFIX=helix_compras_cache_

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_PREFIX=helix_compras_database_

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ADR-015 — receptor de eventos inter-app (POST /api/inbound/events).
# Segredo POR PAR do remetente "store" (deve ser igual ao RELAY_COMPRAS_SECRET
# do Store). Sem ele, o receptor rejeita (401). Gere: openssl rand -hex 32
HELIX_INBOUND_SECRET_STORE=
# Allowlist de TENANTS que o Store pode publicar aqui (CSV de UUIDs).
# OBRIGATÓRIA desde a fundação v0.2.0: é FAIL-CLOSED — sem entrada para o
# remetente `store`, TODO envelope assinado dele leva 403 (o HMAC autentica o
# app, não o par app↔tenant; um segredo vazado escreveria em qualquer tenant).
# Preencha com os UUIDs dos tenants da Rede Comendador que têm loja (Store)
# integrada ao Compras — o mesmo tenant_id que viaja no envelope.
#   HELIX_INBOUND_TENANTS_STORE=uuid-do-tenant-a,uuid-do-tenant-b
# O curinga "*" existe só para homologação/integração e sai como AVISO no
# `php artisan helix:doctor`.
HELIX_INBOUND_TENANTS_STORE=
# Allowlist opcional de eventos aceitos (CSV). Vazio = aceita qualquer nome assinado.
HELIX_INBOUND_ACCEPT=store.purchase_request.created
