APP_NAME="HELIX Compras"
APP_ENV=local
APP_KEY=
# Produção: SEMPRE false (debug expõe stack/env). Dev local: true.
APP_DEBUG=false
APP_URL=http://localhost

# Proxies confiáveis (ALB/nginx): CSV de IPs/CIDRs ou "*". Vazio = nenhum proxy
# confiado (X-Forwarded-* ignorados). Lido em config/trustedproxy.php.
TRUSTED_PROXIES=

# ── Tenancy fail-closed (helix/foundation v0.2.0) ──────────────────────────────
# NÃO EXISTE ENV PARA ISTO. `tenancy.strict` e `tenancy.enforce_stamp` são LITERAIS
# `true` em config/foundation.php: consulta/criação em model com BelongsToTenant SEM
# tenant no contexto lança MissingTenantContextException (em vez de rodar sem filtro),
# e gravar noutro tenant lança TenantMismatchException. Comandos/jobs/subscribers
# estabelecem o tenant com TenantContext::runFor/eachTenant.
#
# HELIX_TENANCY_STRICT / HELIX_TENANCY_ENFORCE_STAMP foram REMOVIDAS de propósito:
# declarar a variável VAZIA (`HELIX_TENANCY_STRICT=`) fazia filter_var() devolver
# false e desligava o fail-closed em silêncio. Afrouxar agora exige editar o config,
# o que aparece no PR. Não reintroduza estas variáveis aqui.

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=
# MySQL gerenciado (RDS) exige TLS: caminho do bundle da CA (ex.: global-bundle.pem).
MYSQL_ATTR_SSL_CA=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Cookie/prefixos EXPLÍCITOS por app: apps da suíte no mesmo domínio/Redis não
# podem colidir sessão, cache ou chaves Redis.
SESSION_COOKIE=helix_compras_session
# Produção: cookie só via HTTPS. Dev local sem HTTPS (http://*.test): false.
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# ── 2FA obrigatório ───────────────────────────────────────────────────────────
# Os papéis obrigados pela política (admin + foundation.mandatory_2fa_roles) são
# desviados para a tela de setup até ativarem o 2FA. O default do pacote já liga
# em produção pelo APP_ENV, mas o `helix:doctor --strict-env=production` avalia o
# VALOR RESOLVIDO — com APP_ENV=local (este arquivo e o CI) ele resolveria false e
# reprovaria o build. Declarado explícito, a postura de produção fica no template.
# A suíte desliga em phpunit.xml (a tela de setup redirecionaria os testes de tela).
TWO_FACTOR_ENFORCE=true

# ── WebAuthn / passkeys (fundação v0.6.0, decisão 12) ─────────────────────────
# FAIL-CLOSED: sem rp_id ou sem origins NENHUMA cerimônia acontece — e quem é
# obrigado a usar passkey (o SUPERADMIN sempre, além de mandatory_webauthn_roles)
# não entra. O RP ID é o domínio registrável a que as passkeys ficam presas; as
# origens são as URLs EXATAS deste app. A tela vem de Route::helixWebAuthn().
HELIX_WEBAUTHN_RP_ID=helix.com.br
HELIX_WEBAUTHN_ORIGINS=https://compras.helix.com.br

BROADCAST_CONNECTION=log
# Dev: local. Produção: s3 (preencha AWS_* abaixo e AWS_BUCKET).
FILESYSTEM_DISK=local
# FILESYSTEM_DISK=s3
QUEUE_CONNECTION=database

# Scheduler onOneServer()/withoutOverlapping() usam o lock do cache default:
# em produção multi-nó o store tem de ser COMPARTILHADO (redis ou database) —
# com file/array cada nó tem o próprio lock e as tarefas rodam N vezes.
CACHE_STORE=database
CACHE_PREFIX=helix_compras_cache_

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_PREFIX=helix_compras_database_

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ── Canal de SISTEMA da suíte (fundação v0.7.0, decisão 13) ───────────────────
# Convite, link de redefinição de senha e confirmação de troca de e-mail saem por
# um mailer PRÓPRIO (`system`, declarado em config/mail.php), com remetente num
# SUBDOMÍNIO DA SUÍTE — com SPF/DKIM/DMARC dela. Separado do mailer do app, que
# fala em nome do cliente. FAIL-CLOSED: sem o mailer declarado ou sem o remetente,
# o e-mail de sistema não sai (e o `helix:doctor` REPROVA produção).
# O `SystemChannelGuard` CANCELA qualquer mensagem que saia com este remetente sem
# ser um Helix\Foundation\Contracts\SystemMessage.
HELIX_SYSTEM_MAILER=system
HELIX_SYSTEM_MAIL_HOST=
HELIX_SYSTEM_MAIL_PORT=587
HELIX_SYSTEM_MAIL_USERNAME=
HELIX_SYSTEM_MAIL_PASSWORD=
HELIX_SYSTEM_MAIL_FROM_ADDRESS=no-reply@sistema.helix.com.br
HELIX_SYSTEM_MAIL_FROM_NAME=HELIX

# ── Canal COMERCIAL do cliente (decisão 13) ───────────────────────────────────
# A solicitação de cotação ao FORNECEDOR fala em nome da empresa, então sai pelo
# domínio de envio DELA, cadastrado pelo admin em /admin/canais. A plataforma
# declara aqui os servidores SMTP aceitos (sufixos de host, CSV) — FAIL-CLOSED:
# lista vazia = nenhum host aceito no cadastro do canal, e sem canal ATIVO o
# e-mail de cotação falha fechado (nunca cai para o canal da suíte).
HELIX_CHANNEL_SMTP_ALLOWED_HOSTS=email-smtp.us-east-1.amazonaws.com
# Domínios que nenhum tenant pode declarar como domínio de envio (o do sistema já
# entra sempre, com os subdomínios dele).
HELIX_CHANNEL_RESERVED_DOMAINS=helix.com.br
# Teto de mensagens comerciais por tenant+canal por minuto.
HELIX_CHANNEL_RATE_PER_MINUTE=60

# ── Raiz dos LINKS de e-mail (4ª auditoria, FUNDACAO-2) ───────────────────────
# `route()` monta a URL com o Host do request: um POST com Host forjado na ação que
# dispara o link fazia o e-mail legítimo levar o token para o atacante. A raiz vem
# da config (vazio = APP_URL, que precisa ser https em produção) e as origens
# aceitas nos TEMPLATES de URL vêm da allowlist abaixo.
HELIX_LINK_BASE_URL=
HELIX_LINK_ALLOWED_ORIGINS=

# Hosts confiáveis do `trustHosts()` (CSV, sem esquema). Vazio = o host do APP_URL.
# Sem isto o Laravel aceita qualquer cabeçalho Host e todo url()/route() do app é
# envenenável. O `helix:doctor` REPROVA produção sem trustHosts.
TRUSTED_HOSTS=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ADR-015 — receptor de eventos inter-app (POST /api/inbound/events).
# Segredo POR PAR do remetente "store" (deve ser igual ao RELAY_COMPRAS_SECRET
# do Store). Sem ele, o receptor rejeita (401). Gere: openssl rand -hex 32
HELIX_INBOUND_SECRET_STORE=
# Allowlist de TENANTS que o Store pode publicar aqui (CSV de UUIDs).
# OBRIGATÓRIA desde a fundação v0.2.0: é FAIL-CLOSED — sem entrada para o
# remetente `store`, TODO envelope assinado dele leva 403 (o HMAC autentica o
# app, não o par app↔tenant; um segredo vazado escreveria em qualquer tenant).
# Preencha com os UUIDs dos tenants da Rede Comendador que têm loja (Store)
# integrada ao Compras — o mesmo tenant_id que viaja no envelope.
#   HELIX_INBOUND_TENANTS_STORE=uuid-do-tenant-a,uuid-do-tenant-b
# O curinga "*" existe só para homologação/integração e sai como AVISO no
# `php artisan helix:doctor`.
HELIX_INBOUND_TENANTS_STORE=
# Allowlist de CONTRATOS (nomes de evento) aceitos, em CSV. FAIL-CLOSED desde a
# fundação v0.4.0: VAZIA ou ausente = TODO evento é recusado (422) — a integração
# com o Store para em silêncio. Até a v0.3.x vazio aceitava qualquer nome assinado
# (um segredo vazado injetava qualquer contrato). Liste só o que o Compras consome;
# o curinga "*" existe só para homologação e o doctor reprova em produção.
# OBRIGATÓRIA no .env de produção:
HELIX_INBOUND_ACCEPT=store.purchase_request.created

# Captura IMAP das respostas de cotação (cotacoes:capturar-respostas).
# Sem IMAP_HOST a captura é um no-op. Com IMAP_HOST, IMAP_AUTHSERV_ID é
# OBRIGATÓRIO: é o authserv-id que o NOSSO MTA de entrada escreve no
# Authentication-Results (ex.: mx.empresa.com.br; Google Workspace = mx.google.com).
# Vazio = a captura falha sem ler a caixa. O MTA precisa remover os A-R que
# chegam de fora com esse id (RFC 8601 §5).
# IMAP_EXIGIR_AUTENTICACAO só desliga com false/0/off/no explícito (vazio = ligado).
IMAP_HOST=
IMAP_AUTHSERV_ID=
